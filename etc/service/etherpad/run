#!/bin/bash -e

trap 'echo "ERROR: $BASH_SOURCE:$LINENO $BASH_COMMAND" >&2' ERR

if [ ! -f /etherpad/APIKEY.txt ]; then
  pwgen -s 40 -1 > /etherpad/APIKEY.txt
fi

# Etherpad writes runtime state (e.g., the list of installed plugins) into var/ and fails to start
# if it cannot. Everything else stays owned by root, so Etherpad cannot install plugins or other code.
chown -Rh etherpad:etherpad /etherpad/var

export HOME=/home/etherpad

cd /etherpad/src
exec chpst -u etherpad:etherpad /usr/bin/node --require tsx/cjs node/server.ts
